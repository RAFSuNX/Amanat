FROM alpine:3.19

# pg_dump client + AWS CLI (S3-compatible, works with R2)
RUN apk add --no-cache \
    postgresql16-client \
    aws-cli \
    gzip \
    tzdata

# Set timezone to Dhaka
ENV TZ=Asia/Dhaka

COPY scripts/backup.sh /backup.sh
RUN chmod +x /backup.sh

# Daily at 02:00 Dhaka time
RUN echo "0 2 * * * /backup.sh >> /var/log/backup.log 2>&1" > /etc/crontabs/root

CMD ["crond", "-f", "-l", "2"]
