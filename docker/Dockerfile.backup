FROM postgres:17-alpine

# postgres:17-alpine already has pg_dump, psql, and pg_restore
RUN apk add --no-cache tzdata

ENV TZ=Asia/Dhaka

COPY scripts/backup.sh /backup.sh
COPY scripts/backup-preflight.sh /backup-preflight.sh
RUN chmod +x /backup.sh /backup-preflight.sh

# Daily at 02:00 Dhaka time
RUN echo "0 2 * * * /backup.sh >> /var/log/backup.log 2>&1" > /etc/crontabs/root

# Check DBs are reachable at container start, then run cron in the foreground.
CMD ["sh", "-c", "/backup-preflight.sh && crond -f -l 2"]
